  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "edit": "EDITOR=1 vite dev",
    "build": "npm run generate && vite build",
    "preview": "vite preview",
    "generate": "tsx scripts/generate-geojson.ts && tsx scripts/export-texts.ts",
    "textos": "tsx scripts/export-texts.ts",
    "validate": "tsx scripts/validate-data.ts",
    "review": "tsx scripts/review.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:editor": "playwright test -c playwright.editor.config.ts"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
